[image=20m]
[virtual=x86_64,multiboot] boot = {
  startup-apic -D8250..115200 -zz  

  PATH=/usr/bin
  CONFIG_PATH=/usr/lib
  LD_LIBRARY_PATH=/usr/lib:/usr/lib/pci
  [+keeplinked uid=0 gid=0 perms=0700] procnto-smp-instr -mr -d 0777 -u 0777
}

[+script] startup-script = {
  display_msg "Welcome to QNX OS 8.0 on x86_64!"

  slogger2

  devc-ser8250 -e 
  waitfor /dev/ser1
  reopen /dev/ser1

  PCI_HW_MODULE=pci_hw-Intel_x86.so
  PCI_BKWD_COMPAT_MODULE=pci_bkwd_compat.so
  PCI_SLOG_MODULE=pci_slog2.so
  PCI_CAP_MODULE_DIR=/usr/lib/pci
  PCI_BASE_VERBOSITY=3

  display_msg "---> Starting PCI Services"
  pci-server --config=/etc/pci_server.cfg

  [+session] sh &

  dev-virtio-gpio &

  display_msg "Startup complete"
}

#############################################
### PCI
#############################################

[perms=0444] /etc/pci_server.cfg = {
[buscfg]
DO_BUS_CONFIG=no

[envars]
PCI_DEBUG_MODULE=pci_debug2.so
PCI_HW_MODULE=pci_hw-Intel_x86.so
PCI_HW_CONFIG_FILE=/etc/pci_hw.cfg
}

[perms=0444] /etc/pci_hw.cfg = {
[interrupts]
B0:D17:F0    A    18
B0:D17:F0    B    19
B0:D17:F0    C    16
B0:D17:F0    D    17
B3:D0:F0     A    18
B3:D0:F0     B    19
B3:D0:F0     C    16
B3:D0:F0     D    17
}

# Libraries
/usr/lib/ldqnx-64.so.2=ldqnx-64.so.2
/usr/lib/libc.so.6=libc.so.6
/usr/lib/libfsnotify.so.1=libfsnotify.so.1
/usr/lib/libgcc_s.so.1=libgcc_s.so.1
/usr/lib/libm.so.3=libm.so.3
/usr/lib/libpci.so.3.0=libpci.so.3.0
/usr/lib/libsecpol.so.1=libsecpol.so.1
/usr/lib/libslog2.so.1=libslog2.so.1
/usr/lib/libslog2parse.so.1=libslog2parse.so.1
/usr/lib/libz.so.2=libz.so.2
/usr/lib/pci/pci_bkwd_compat.so=pci/pci_bkwd_compat.so
/usr/lib/pci/pci_cap-0x05.so=pci/pci_cap-0x05.so
/usr/lib/pci/pci_cap-0x01.so=pci/pci_cap-0x01.so
/usr/lib/pci/pci_cap-0x09-ffffffff.so=pci/pci_cap-0x09-ffffffff.so
/usr/lib/pci/pci_cap-0x09-1af4ffff.so=pci/pci_cap-0x09-ffffffff.so
/usr/lib/pci/pci_cap-0x10.so=pci/pci_cap-0x10.so
/usr/lib/pci/pci_cap-0x11.so=pci/pci_cap-0x11.so
/usr/lib/pci/pci_debug2.so=pci/pci_debug2.so
/usr/lib/pci/pci_hw-Intel_x86.so=pci/pci_hw-Intel_x86.so
/usr/lib/pci/pci_slog2.so=pci/pci_slog2.so
/usr/lib/pci/pci_strings.so=pci/pci_strings.so

# Binaries
/usr/bin/devc-ser8250=devc-ser8250
/usr/bin/pci-server=pci-server
/usr/bin/pci-tool=pci-tool
/usr/bin/pidin=pidin
/usr/bin/rsrcdb_query=rsrcdb_query
/usr/bin/sh=sh
/usr/bin/shutdown=shutdown
/usr/bin/slog2info=slog2info
/usr/bin/slogger2=slogger2
/usr/bin/toybox=toybox

[type=link] /usr/bin/cat=toybox
[type=link] /usr/bin/ls=toybox
[type=link] /usr/bin/xxd=toybox

# VirtIO
/usr/bin/dev-virtio-gpio=dev-virtio-gpio
